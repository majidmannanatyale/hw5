# Copy this file to .env (in hw5/) and fill in real values. Never commit .env.

# AI model access, routed through the Portkey gateway.
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# This project only allows gpt-6-luna; the backend refuses to start with any other model.
OPENAI_MODEL=gpt-6-luna

# Optional run limits (defaults shown).
TOKEN_BUDGET=150000
TOKEN_WARN_PCT=0.6
REQUEST_LIMIT=60
MAX_DELEGATIONS=12
